<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body {
        font-family: Arial, sans-serif;
        line-height: 1.6;
        margin: 0;
        padding: 0;
        color: black;
        background-color: white;
      }

      .childTemplate {
        width: 100%;
        max-width: 650px;
        padding: 20px;
        min-height: 100vh;
        position: relative;
        box-sizing: border-box;
        border: 2px solid black;
        margin: auto;
        background-color: #fff;
      }

      .header {
        text-align: center;
        padding: 10px;
        background-color: #012953;
        color: #fff;
        border-bottom: 1px solid #ddd;
      }

      .order-details {
        margin-top: 20px;
      }

      .order-items {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
      }

      .order-items th,
      .order-items td {
        border: 2px solid #000;
        padding: 8px;
        text-align: left;
      }

      .team-name {
        margin-bottom: 150px;
      }

      .image {
        width: 100%;
        height: 250px; /* Fixed height for the image */
        object-fit: cover; /* Ensures the image covers the area without distorting */
      }

      @media (max-width: 600px) {
        .container {
          width: 100%;
          max-width: 600px;
          margin: auto;
          padding: 20px;
          background-image: url("https://verify.proteanx.io/vc-services/credentials/getPhoto/77150431");
          background-size: cover;
          background-position: center;
          min-height: 80vh;
          position: relative;
          box-sizing: border-box;
        }

        .header {
          text-align: center;
          padding: 10px;
          background-color: #012953;
          color: #fff;
          border-bottom: 1px solid #ddd;
        }

        .order-details {
          margin-top: 20px;
        }

        .order-items {
          width: 100%;
          border-collapse: collapse;
          margin-top: 10px;
          padding: 10px;
        }

        .order-items th,
        .order-items td {
          padding: 6px;
        }

        .header h1 {
          font-size: 20px;
        }

        .body {
          font-size: 14px;
        }
      }
    </style>
  </head>
  
  <body>
    <div class="childTemplate">
      <img
        src="https://user-images.githubusercontent.com/4006792/214636328-8e4f83e8-66cb-4114-a3d8-473eb908b9c3.png"
        alt="Saleor Logo"
        style="width: 150px; height: auto"
      />

      <div class="header">
        <h1 class="subject"><%= data.title %></h1>
      </div>
      <p>Dear <%= data.customerName %>,</p>
      <p class="body"><%- data.body %></p>

      <% if (data.cart && data.cart.items && data.cart.items.length > 0) { %>
      <div class="order-details">
        <h2>Order Details</h2>
        <table class="order-items">
          <thead>
            <tr>
              <th>Item</th>
              <th>Quantity</th>
              <th>Price</th>
            </tr>
          </thead>
          <tbody>
            <% data.cart.items.forEach(function(item) { %>
            <tr>
              <td><%= item.name %></td>
              <td><%= item.quantity.count %></td>
              <td><%= data.currency + ' ' + item.price.value %></td>
            </tr>
            <% }); %>

            <tr>
              <td colspan="2">Delivery Charges</td>
              <td>
                <%= (data.cart?.additions?.delivery?.value ? data.currency + ' ' + data.cart.additions.delivery.value :
                'Rs. 0') %>
              </td>
            </tr>

            <tr>
              <td colspan="2">Packing Charges</td>
              <td>
                <%= (data.cart?.additions?.packing?.value ? data.currency + ' ' + data.cart.additions.packing.value :
                'Rs. 0') %>
              </td>
            </tr>

            <tr>
              <td colspan="2">Convenience Fee</td>
              <td>
                <%= (data.cart?.additions?.misc?.value ? data.currency + ' ' + data.cart.additions.misc.value : 'Rs. 0')
                %>
              </td>
            </tr>

            <tr>
              <td colspan="2">Tax</td>
              <td>
                <%= (data.cart?.additions?.tax?.value ? data.currency + ' ' + data.cart.additions.tax.value : 'Rs. 0')
                %>
              </td>
            </tr>

            <tr>
              <td colspan="2">Discount</td>
              <td>
                <%= (data.cart?.deductions?.discount?.value ? data.currency + ' ' + data.cart.deductions.discount.value
                : 'Rs. 0') %>
              </td>
            </tr>

            <tr>
              <td colspan="2">Total</td>
              <td><%= data.currency + ' ' + (data.cart.price.value ?? 0) %></td>
            </tr>
          </tbody>
        </table>
      </div>
      <% } %> 

      <% if (data.emailReturnItems && data.emailReturnItems.length > 0) { %>
      <div class="order-details">
        <table class="order-items">
          <thead>
            <tr>
              <th>Item</th>
              <th>Quantity</th>
              <th>Price</th>
            </tr>
          </thead>
          <tbody>
            <% data.emailReturnItems.forEach(function(item) { %>
            <tr>
              <td><%= item.name %></td>
              <td><%= item.count %></td>
              <td><%= data.currency + ' ' + item.price %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } %>

      <% if (data.arrivingDate) { %>
      <p>Estimated delivery by <%= data.arrivingDate %>.</p>
      <br />
      <% } %> 

      <% if (data.emailRefundStatement) { %>
      <p><%= data.emailRefundStatement %></p>
      <br />
      <% } %>

      <p>If you have any questions, feel free to contact our support team.</p>
      <p>Best regards,</p>
      <p class="team-name"><b><%= data.team %> Team</b></p>

      <div>
        <img
          class="image"
          src="https://i.im.ge/2024/11/15/zMp5NT.Frame-1410087162.png"
          alt="Team Image"
        />
      </div>
    </div>
  </body>
</html>
